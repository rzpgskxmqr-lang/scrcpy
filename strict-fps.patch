diff --git a/src/video_decoder.h b/src/video_decoder.h
index a611c07..2653084 100644
--- a/src/video_decoder.h
+++ b/src/video_decoder.h
@@ -43,6 +43,8 @@ struct sc_video_decoder {
     sc_video_decoder_on_frame_callback on_frame;
     void *callback_userdata;

+    int32_t strict_fps;
+    sc_tick last_emit_tick;
     bool stopped;
 };
diff --git a/src/video_decoder.c b/src/video_decoder.c
index 1217782..4c22412 100644
--- a/src/video_decoder.c
+++ b/src/video_decoder.c
@@ -212,6 +212,9 @@ sc_video_decoder_create(const struct sc_decoder_params *params,
     decoder->on_frame = params->on_frame;
     decoder->callback_userdata = params->callback_userdata;

+    decoder->strict_fps = params->opts->strict_fps;
+    decoder->last_emit_tick = 0;
+
     decoder->stopped = false;
     return decoder;
 }

@@ -420,6 +423,20 @@ sc_video_decoder_push_frame(struct sc_video_decoder *decoder, AVFrame *frame)
         return true;
     }

+    if (decoder->strict_fps > 0) {
+        sc_tick now = sc_tick_now();
+        sc_tick min_interval = SC_TICK_FROM_US(1000000 / decoder->strict_fps);
+
+        if (decoder->last_emit_tick != 0
+            && (now - decoder->last_emit_tick) < min_interval) {
+            av_frame_free(&frame);
+            return true;
+        }
+        decoder->last_emit_tick = now;
+    }
+
     decoder->on_frame(decoder, frame, decoder->callback_userdata);
     return true;
 }
