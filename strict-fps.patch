diff --git a/src/cli.c b/src/cli.c
index 079b712..d172073 100644
--- a/src/cli.c
+++ b/src/cli.c
@@ -142,6 +142,7 @@ static const struct option long_options[] = {
     {"no-video", no_argument, NULL, 'v'},
     {"no-video-playback", no_argument, NULL, 'V'},
     {"otg", no_argument, NULL, 'O'},
+    {"strict-fps", required_argument, NULL, 0x100},
     {"port", required_argument, NULL, 'p'},
     {"power-off-on-close", no_argument, NULL, 0x101},
     {"prefer-text", no_argument, NULL, 0x102},
@@ -632,6 +633,11 @@ parse_args(int argc, char *argv[], struct sc_options *opts)
             opts->otg = true;
             break;

+        case 0x100:
+            opts->strict_fps = atoi(optarg);
+            if (opts->strict_fps < 1) {
+                LOGE("strict-fps must be >= 1");
+                return false;
+            }
+            break;
         case 'p':
             opts->port = atoi(optarg);
             if (opts->port <= 0 || opts->port > 65535) {
@@ -1300,6 +1306,8 @@ print_usage(void)
     "      --no-video-playback   disable video playback (still record)\n"
     "      --otg                 run OTG mode (HID keyboard/mouse)\n"
     "      -p, --port PORT       port to use\n"
+    "      --strict-fps N        strict render fps cap, drop excess frames\n"
+    "                            (rate shaping, no interpolation)\n"
     "      --power-off-on-close  power off device on exit\n"
     "      --prefer-text         prefer text injection\n"
     "      --raw-key-events      send raw key events\n"
